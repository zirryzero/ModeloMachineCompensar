# --------------------------------------------------
# Environment & Sensitive Information
# --------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.cert

# --------------------------------------------------
# Composer / Dependencies
# --------------------------------------------------
/vendor/
composer.phar

# --------------------------------------------------
# CodeIgniter 4 Writable Directory
# --------------------------------------------------
writable/cache/*
!writable/cache/index.html
!writable/cache/.gitkeep

writable/debugbar/*
!writable/debugbar/.gitkeep

writable/logs/*
!writable/logs/index.html
!writable/logs/.gitkeep

writable/session/*
!writable/session/index.html
!writable/session/.gitkeep

writable/uploads/*
!writable/uploads/index.html
!writable/uploads/.gitkeep

# --------------------------------------------------
# Testing & Build Outputs
# --------------------------------------------------
.phpunit.result.cache
.phpunit.cache
/build/

# --------------------------------------------------
# Documentation
# --------------------------------------------------
userguide3/
userguide4/

# --------------------------------------------------
# IDEs & Text Editors
# --------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --------------------------------------------------
# Operating System Files
# --------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# --------------------------------------------------
# Python / Machine Learning (if applicable)
# --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/
.venv/
venv/
*.pkl
*.joblib
*.h5
*.model
